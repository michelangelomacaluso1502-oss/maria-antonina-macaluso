{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/film/layout,_N_T_/film/[slug]/layout,_N_T_/film/[slug]/page,_N_T_/film/provvidenza"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/film/$d$slug/__PAGE__",
    "/film/$d$slug",
    "/film",
    "/_index",
    "/_head"
  ]
}