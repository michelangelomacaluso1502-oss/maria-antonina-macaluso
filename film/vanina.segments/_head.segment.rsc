0:{"buildId":"RzRFvYsmr2YbS0QiEb3jI","rsc":["$","$1","h",{"children":[null,["$","$L2",null,{"children":[["$","meta","0",{"charSet":"utf-8"}],["$","meta","1",{"name":"viewport","content":"width=device-width, initial-scale=1, viewport-fit=cover"}],["$","meta","2",{"name":"theme-color","content":"#08070a"}]]}],["$","div",null,{"hidden":true,"children":["$","$L3",null,{"children":["$","$4",null,{"name":"Next.Metadata","children":[["$","title","0",{"children":"Vanina — Un vicequestore a Catania (2024) — M.A.M."}],["$","meta","1",{"name":"description","content":"Vanina — Un vicequestore a Catania (2024) è una serie televisiva trasmessa su Canale 5 (Mediaset), regia di Davide Marengo, basata sui romanzi di Cristina Cassar Scalia. La serie segue le indagini di Vanina Guarrasi, vicequestore della sezione omicidi di Catania. Maria Antonina Macaluso ha partecipato a un episodio della prima stagione (IMDb, 2024). Una partecipazione che segna la presenza dell'attrice in una produzione Mediaset di prime time accanto a Giusy Buscemi (protagonista) e al cast corale della serie."}],["$","meta","2",{"name":"author","content":"Maria Antonina Macaluso"}],["$","link","3",{"rel":"manifest","href":"/manifest.webmanifest"}],["$","meta","4",{"name":"keywords","content":"Maria Antonina Macaluso,attrice siciliana,Camporeale,Palermo,Angelo Faraci,cinema siciliano,Pochi Attimi,Rai Cinema,Taormina,Fiuggi"}],["$","meta","5",{"name":"creator","content":"Maria Antonina Macaluso"}],["$","meta","6",{"name":"robots","content":"index, follow"}],["$","meta","7",{"name":"googlebot","content":"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}],["$","link","8",{"rel":"canonical","href":"https://mariaantoninamacaluso.it/film/vanina"}],["$","meta","9",{"property":"og:title","content":"Vanina — Un vicequestore a Catania (2024)"}],["$","meta","10",{"property":"og:description","content":"Vanina — Un vicequestore a Catania (2024) è una serie televisiva trasmessa su Canale 5 (Mediaset), regia di Davide Marengo, basata sui romanzi di Cristina Cassar Scalia. La serie segue le indagini di Vanina Guarrasi, vicequestore della sezione omicidi di Catania. Maria Antonina Macaluso ha partecipato a un episodio della prima stagione (IMDb, 2024). Una partecipazione che segna la presenza dell'attrice in una produzione Mediaset di prime time accanto a Giusy Buscemi (protagonista) e al cast corale della serie."}],["$","meta","11",{"property":"og:image","content":"https://mariaantoninamacaluso.it/images/films/vanina.jpg"}],["$","meta","12",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","13",{"name":"twitter:title","content":"Maria Antonina Macaluso — Attrice Siciliana"}],["$","meta","14",{"name":"twitter:description","content":"Maria Antonina Macaluso, attrice siciliana. Enciclopedia digitale ufficiale."}],["$","meta","15",{"name":"twitter:image","content":"https://mariaantoninamacaluso.it/images/hero-maria-antonina.jpg"}],["$","link","16",{"rel":"icon","href":"/icons/icon.svg"}],["$","link","17",{"rel":"apple-touch-icon","href":"/icons/icon.svg"}],["$","$L5","18",{}]]}]}]}],null]}],"loading":null,"isPartial":false}
