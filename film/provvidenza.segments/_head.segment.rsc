0:{"buildId":"RGtxSQQ9Yl0hBnK1kIcSj","rsc":["$","$1","h",{"children":[null,["$","$L2",null,{"children":[["$","meta","0",{"charSet":"utf-8"}],["$","meta","1",{"name":"viewport","content":"width=device-width, initial-scale=1, viewport-fit=cover"}],["$","meta","2",{"name":"theme-color","content":"#08070a"}]]}],["$","div",null,{"hidden":true,"children":["$","$L3",null,{"children":["$","$4",null,{"name":"Next.Metadata","children":[["$","title","0",{"children":"Provvidenza (2022) — M.A.M."}],["$","meta","1",{"name":"description","content":"Provvidenza (2022) è un cortometraggio Rai Cinema scritto e diretto da Angelo Faraci, girato tra le strade di Montalbano Elicona e i paesaggi della Sicilia nord-orientale. La tematica centrale è la violenza sulle donne — fisica e psicologica — in una Sicilia che marginalizza la donna a strumento domestico. L'opera vince il Premio Migliore Sceneggiatura al Ciak Film Festival International di Fiuggi (Oscar d'Oro) e il Premio Luchino Visconti al Ciclopi Summer Fest di Aci Trezza. Maria Antonina Macaluso è la protagonista femminile del cortometraggio, premiata accanto al regista sul red carpet di Fiuggi."}],["$","meta","2",{"name":"author","content":"Maria Antonina Macaluso"}],["$","link","3",{"rel":"manifest","href":"/manifest.webmanifest"}],["$","meta","4",{"name":"keywords","content":"Maria Antonina Macaluso,attrice siciliana,Camporeale,Palermo,Angelo Faraci,cinema siciliano,Pochi Attimi,Rai Cinema,Taormina,Fiuggi"}],["$","meta","5",{"name":"creator","content":"Maria Antonina Macaluso"}],["$","meta","6",{"name":"robots","content":"index, follow"}],["$","meta","7",{"name":"googlebot","content":"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}],["$","link","8",{"rel":"canonical","href":"https://mariaantoninamacaluso.it/film/provvidenza"}],["$","meta","9",{"property":"og:title","content":"Provvidenza (2022)"}],["$","meta","10",{"property":"og:description","content":"Provvidenza (2022) è un cortometraggio Rai Cinema scritto e diretto da Angelo Faraci, girato tra le strade di Montalbano Elicona e i paesaggi della Sicilia nord-orientale. La tematica centrale è la violenza sulle donne — fisica e psicologica — in una Sicilia che marginalizza la donna a strumento domestico. L'opera vince il Premio Migliore Sceneggiatura al Ciak Film Festival International di Fiuggi (Oscar d'Oro) e il Premio Luchino Visconti al Ciclopi Summer Fest di Aci Trezza. Maria Antonina Macaluso è la protagonista femminile del cortometraggio, premiata accanto al regista sul red carpet di Fiuggi."}],["$","meta","11",{"property":"og:image","content":"https://mariaantoninamacaluso.it/images/films/provvidenza.jpg"}],["$","meta","12",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","13",{"name":"twitter:title","content":"Maria Antonina Macaluso — Attrice Siciliana"}],["$","meta","14",{"name":"twitter:description","content":"Maria Antonina Macaluso, attrice siciliana. Enciclopedia digitale ufficiale."}],["$","meta","15",{"name":"twitter:image","content":"https://mariaantoninamacaluso.it/images/hero-maria-antonina.jpg"}],["$","link","16",{"rel":"icon","href":"/icons/icon.svg"}],["$","link","17",{"rel":"apple-touch-icon","href":"/icons/icon.svg"}],["$","$L5","18",{}]]}]}]}],null]}],"loading":null,"isPartial":false}
