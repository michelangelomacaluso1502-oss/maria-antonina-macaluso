9:["$","$L3","Premio Speciale Leone Lungo2026",{"delay":90,"children":["$","article",null,{"className":"glass-card group card-lift-premium h-full p-6","children":[["$","div",null,{"className":"flex items-center justify-between","children":[["$","span",null,{"className":"flex h-10 w-10 items-center justify-center rounded-full border border-gold/40 bg-gold/5 text-gold","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-award h-5 w-5","aria-hidden":"true","children":[["$","path","1yiouv",{"d":"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"}],["$","circle","1vp47v",{"cx":"12","cy":"8","r":"6"}],"$undefined"]}]}],["$","span",null,{"className":"font-display text-3xl text-gold/40","children":"2026"}]]}],["$","h3",null,{"className":"mt-4 font-display text-xl leading-snug text-cream group-hover:text-gold","children":"Premio Speciale Leone Lungo"}],["$","p",null,{"className":"mt-1 text-xs uppercase tracking-wide-sm text-gold/70","children":"83ª Mostra del Cinema di Venezia — Evento collaterale Maxa Film"}],["$","p",null,{"className":"mt-3 text-sm leading-relaxed text-cream/65","children":"Il film Pochi Attimi, diretto da Angelo Faraci con Maria Antonina Macaluso come attrice protagonista femminile, riceve il Premio Speciale 'Leone Lungo' il 6 settembre 2026 nell'ambito degli eventi collaterali della 83ª Mostra Internazionale d'Arte Cinematografica di Venezia. La presentazione nazionale di esclusiva si è tenuta presso l'Area Hospitality Maxafilm, Hotel Excelsior, Lido di Venezia. Il premio, ideato da Donato Pugliese (Presidente Maxa Film srl) con l'associazione di terzo settore Le Stelle del Sud, mette in risalto il lungometraggio italiano che più si è distinto come progetto storico-culturale. Il film è dedicato alle Catastrofi ambientali Italiane e al valore reale della vita."}]]}]}]
