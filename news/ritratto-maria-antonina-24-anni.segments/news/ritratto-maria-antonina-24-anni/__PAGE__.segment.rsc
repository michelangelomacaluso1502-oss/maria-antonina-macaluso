2:T4a9,{"@context":"https://schema.org","@type":"Article","headline":"Ritratto di Maria Antonina Macaluso a 24 anni — attrice, content creator, siciliana","description":"Ritratto umano e artistico di Maria Antonina Macaluso a 24 anni: dieci film con Angelo Faraci, Premio Leone Lungo a Venezia 83, content creator su Instagram e TikTok, radici camporealesi.","image":["https://mariaantoninamacaluso.it/images/photobook/mam-12.jpg"],"datePublished":"2026-09-28T16:00:00Z","dateModified":"2026-09-28T16:00:00Z","author":{"@type":"Organization","name":"Maria Antonina Macaluso — Enciclopedia digitale","url":"https://mariaantoninamacaluso.it"},"publisher":{"@type":"Organization","name":"Maria Antonina Macaluso — Enciclopedia digitale","url":"https://mariaantoninamacaluso.it"},"url":"https://mariaantoninamacaluso.it/news/ritratto-maria-antonina-24-anni","mainEntityOfPage":{"@type":"WebPage","url":"https://mariaantoninamacaluso.it/news/ritratto-maria-antonina-24-anni"},"about":[{"@type":"Person","name":"Maria Antonina Macaluso"}],"inLanguage":"it-IT","articleSection":"Ritratto umano","keywords":["Maria Antonina Macaluso","ritratto","24 anni","attrice siciliana","Camporeale","Venezia 83"]}0:{"buildId":"mO1Yve1mb5-k8xyJT_8DO","rsc":["$","$1","c",{"children":[["$","main",null,{"id":"main","children":[[["$","link",null,{"rel":"alternate","hrefLang":"it-IT","href":"https://mariaantoninamacaluso.it"}],["$","link",null,{"rel":"alternate","hrefLang":"x-default","href":"https://mariaantoninamacaluso.it"}],[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://mariaantoninamacaluso.it/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News\",\"item\":\"https://mariaantoninamacaluso.it/news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Ritratto 24 anni\"}]}"}}],["$","script","1",{"type":"a