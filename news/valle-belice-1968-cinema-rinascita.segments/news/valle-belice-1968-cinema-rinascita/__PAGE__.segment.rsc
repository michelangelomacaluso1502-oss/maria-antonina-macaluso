x] uppercase tracking-wide-sm text-gold/70","children":"Magnitudo"}],["$","p",null,{"className":"mt-1 font-display text-base text-cream","children":"6.4 Mw"}]]}],["$","div","2",{"className":"glass-card p-4","children":[["$","p",null,{"className":"text-[11px] uppercase tracking-wide-sm text-gold/70","children":"Epicentro"}],["$","p",null,{"className":"mt-1 font-display text-base text-cream","children":"Valle del Belice (TP/PA)"}]]}],["$","div","3",{"className":"glass-card p-4","children":[["$","p",null,{"className":"text-[11px] uppercase tracking-wide-sm text-gold/70","children":"Vittime"}],["$","p",null,{"className":"mt-1 font-display text-base text-cream","children":"~370"}]]}],["$","div","4",{"className":"glass-card p-4","children":[["$","p",null,{"className":"text-[11px] uppercase tracking-wide-sm text-gold/70","children":"Sfollati"}],["$","p",null,{"className":"mt-1 font-display text-base text-cream","children":"~70.000"}]]}],["$","div","5",{"className":"glass-card p-4","children":[["$","p",null,{"className":"text-[11px] uppercase tracking-wide-sm text-gold/70","children":"Paesi distrutti"}],["$","p",null,{"className":"mt-1 font-display text-base text-cream","children":"Gibellina, Poggioreale, Salaparuta, Montevago, Santa Margherita"}]]}]]}]]}],["$","$Lb",null,{"className":"mb-12","children":[["$","h2",null,{"className":"font-display text-3xl text-gradient-gold sm:text-4xl","children":"14-15 gennaio 1968 — il terremoto"}],["$","div",null,{"className":"divider-cinema mt-6 max-w-xs"}],["$","div",null,{"className":"mt-6 space-y-4 text-pretty text-base leading-relaxed text-cream/80","children":[["$","p",null,{"children":"Il terremoto della Valle del Belice del 14-15 gennaio 1968 è una delle catastrofi naturali più significative della storia siciliana recente. Con una magnitudo di 6.4 Mw, colpì una delle valli più povere della Sicilia occidentale, tra le province di Trapani e Palermo."}],["$","p",null,{"children":"I paesi di Gibellina, Poggioreale, Salaparuta, Montevago e Santa Margherita di Belice furono completamente distrutti. Le vittime furono circa 370, con oltre 70.000 sfollati. Fu una catastrofe annunciata: la zona era già identificata come sismica, ma le costruzioni erano in pietra calcarea locale senza criteri antisismici."}],"$Lc"]}]]}],"$Ld","$Le","$Lf","$L10","$L11","$L12"]}]}]}]
