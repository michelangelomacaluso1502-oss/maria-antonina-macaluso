d:["$","$Lb",null,{"className":"mb-12","children":[["$","h2",null,{"className":"font-display text-3xl text-gradient-gold sm:text-4xl","children":"Profilo verificato"}],["$","div",null,{"className":"divider-cinema mt-6 max-w-xs"}],["$","div",null,{"className":"mt-6 space-y-4 text-pretty text-base leading-relaxed text-cream/80","children":[["$","p",null,{"children":["Angelo Faraci è un regista, attore e produttore italiano nato a Palermo il 13 agosto 1989. La sua scheda biografica è verificata da IMDb con identificativo",["$","a",null,{"href":"https://www.imdb.com/name/nm11444273/","target":"_blank","rel":"noopener noreferrer","className":"ml-1 inline-flex items-center gap-1 text-gold/80 hover:text-gold","children":["nm11444273",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link h-3 w-3","aria-hidden":"true","children":[["$","path","1q9fwt",{"d":"M15 3h6v6"}],["$","path","gplh6r",{"d":"M10 14 21 3"}],["$","path","a6xqqp",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"}],"$undefined"]}]]}],". È attivo nel cinema siciliano contemporaneo dal 2019."]}],["$","p",null,{"children":"Angelo Faraci è noto per essere il regista della fiction Sky «Ciò che non ti ho detto» (2019), l'unica serie TV italiana con un cast composto esclusivamente da siciliani e volti isolani noti. Nella fiction è anche attore protagonista nel ruolo di Gaetano Scalici, personaggio che interpreta per cinque anni consecutivi."}],["$","p",null,{"children":["L'enciclopedia digitale dedicata ad Angelo Faraci è disponibile all'URL:",["$","a",null,{"href":"https://angelo-faraci.vercel.app","target":"_blank","rel":"noopener noreferrer","className":"ml-1 inline-flex items-center gap-1 text-gold/80 hover:text-gold","children":["angelo-faraci.vercel.app",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","w