":"MYmovies.it"},"description":"Scheda biografica ufficiale di Maria Antonina Macaluso su MYmovies.it — il principale database italiano di cinema. Include biografia, filmografia, premi e news.","datePublished":"2024-01-01T00:00:00Z","about":[{"@type":"Person","name":"Maria Antonina Macaluso"}]},{"@type":"Article","headline":"Pochi Attimi (2026) — Scheda film Cinema Italiano","url":"https://www.cinemaitaliano.info/film/38844/festival/pochi-attimi.html","image":"https://mariaantoninamacaluso.it/images/venezia/venezia-01.jpg","publisher":{"@type":"Organization","name":"Cinema Italiano"},"description":"Scheda del film Pochi Attimi (2026) di Angelo Faraci su Cinema Italiano — database nazionale cinema italiano. Cast, regia, produzione, festival.","datePublished":"2026-01-01T00:00:00Z","about":[{"@type":"Movie","name":"Pochi Attimi"}]}],"performerIn":[{"@type":"Movie","name":"Ciò che non ti ho detto","alternateName":"Ciò che non ti ho detto — Fiction TV Sky","datePublished":"2019","image":"https://mariaantoninamacaluso.it/images/films/cio-che-non-ti-ho-detto.jpg","url":"https://mariaantoninamacaluso.it/film/cio-che-non-ti-ho-detto","director":{"@type":"Person","name":"Angelo Faraci"},"genre":"Fiction TV — Drammatico","productionCompany":{"@type":"Organization","name":"Sky"},"description":"Fiction TV ideata da Angelo Faraci per Sky. L'unica serie TV italiana di soli siciliani e volti isolani noti. Maria Antonina Macaluso partecipa come attrice."},{"@type":"Movie","name":"Don't Be Silent","datePublished":"2020","image":"https://mariaantoninamacaluso.it/images/films/dont-be-silent.jpg","url":"https://mariaantoninamacaluso.it/film/dont-be-silent","director":{"@type":"Person","name":"Angelo Faraci"},"genre":"Cortometraggio — Drammatico sociale","productionCompany":{"@type":"Organization","name":"Rai Cinema"},"description":"Cortometraggio Rai Cinema sul silenzio complice delle violenze quotidiane. Maria Antonina Macaluso è attrice del progetto."},{"@type":"Movie","name":"Provvidenza","datePublished":"2021","image":"https://mariaantoninamacaluso.it/images/films/provvidenza.jpg","url":"https://mariaantoninamacaluso.it/film/provvidenza","director":{"@type":"Person","name":"Angelo Faraci"},"genre":"Cortometraggio — Drammatico","productionCompany":{"@type":"Organization","name":"Rai Cinema"},"description":"Cortometraggio Rai Cinema girato a Montalbano Elicona (Messina). Premio Migliore Sceneggiatura al Ciak Film Festival International di Fiuggi (Oscar d'Oro 2022) e Premio Luchino Visconti al Ciclopi Summer Fest.","sameAs":"https://www.messinatoday.it/attualita/provvidenza-montalbano-premio-sceneggiatura-ciak-film.html"},{"@type":"Movie","name":"Pietrazita","datePublished":"2023","image":"https://mariaantoninamacaluso.it/images/films/pietrazita.jpg","url":"https://mariaantoninamacaluso.it/film/pietrazita","director":{"@type":"Person","name":"Angelo Faraci"},"genre":"Cortometraggio — Drammatico","productionCompany":{"@type":"Organization","name":"Rai Cinema"},"description":"Cortometraggio Rai Cinema ambientato a Sant'Angelo di Brolo (Nebrodi). 2° posto al Tulipani di Seta Nera XVI edizione, Premio Sorriso Rai Cinema Channel."},{"@type":"Movie","name":"Separati Mai","datePublished":"2023","image":"https://mariaantoninamacaluso.it/images/films/separati-mai.jpg","url":"https://mariaantoninamacaluso.it/film/separati-mai","director":{"@type":"Person","name":"Angelo Faraci"},"genre":"Film — Drammatico","productionCompany":{"@type":"Organization","name":"Ancora Cinematografica"},"description":"Film diretto da Angelo Faraci con Maria Antonina Macaluso come interprete femminile principale. Girato tra i borghi siciliani, le scogliere sul mare e le ville antiche."},{"@type":"Movie","name":"Vanina","alternateName":"Vanina — Un vicequestore a Catania","datePublished":"2024","image":"https://mariaantoninamacaluso.it/images/films/vanina.jpg","url":"https://mariaantoninamacaluso.it/film/vanina","director":{"@type":"Person","name":"Davide Marengo"},"genre":"Serie TV — Poliziesco","productionCompany":{"@type":"Organization","name":"Mediaset — Canale 5"},"description":"Serie TV Canale 5 basata sui romanzi di Cristina Cassar Scalia. Maria Antonina Macaluso partecipa a un episodio della prima stagione (Partecipazione, IMDb 2024).","sameAs":"https://www.imdb.com/it/title/tt31721916/"},{"@type":"Movie","name":"Il Mistero di Spartivento","datePublished":"2024","image":"https://mariaantoninamacaluso.it/images/films/il-mistero-di-spartivento.jpg","url":"https://mariaantoninamacaluso.it/film/il-mistero-di-spartivento","director":{"@type":"Person","name":"Angelo Faraci"},"genre":"Film — Suspense mediterraneo","productionCompany":{"@type":"Organization","name":"Ancora Cinematografica"},"description":"Film diretto da Angelo Faraci. Maria Antonina Macaluso è la protagonista femminile in un racconto dove ogni inquadratura nasconde un indizio."},{"@type":"Movie","name":"Eccellenza Siciliana","datePublished":"2025","image":"https://mariaantoninamacaluso.it/images/films/eccellenza-siciliana.jpg","url":"https://mariaantoninamacaluso.it/altre-produzioni/eccellenza-siciliana","director":{"@type":"Person","name":"Angelo Faraci"},"genre":"Film TV / Web — Documentario enogastronomico","productionCompany":{"@type":"Organization","name":"Angelo Faraci — Produzione indipendente"},"description":"Film TV e Web (2025) diretto da Angelo Faraci. Un viaggio attraverso la Sicilia alla scoperta dei prodotti di eccellenza. Maria Antonina Macaluso co-protagonista in viaggio con Angelo Faraci. IMDb: tt38949464.","sameAs":"https://www.imdb.com/title/tt38949464"},{"@type":"Movie","name":"Pochi Attimi","datePublished":"2026","image":"https://mariaantoninamacaluso.it/images/films/pochi-attimi.jpg","url":"https://mariaantoninamacaluso.it/film/pochi-attimi","director":{"@type":"Person","name":"Angelo Faraci"},"genre":"Lungometraggio — Drammatico sociale","productionCompany":{"@type":"Organization","name":"Ancora Cinematografica + Ventitreesima Strada"},"description":"Lungometraggio diretto da Angelo Faraci con Maria Antonina Macaluso come attrice protagonista femminile. Dedicato alle Catastrofi ambientali Italiane e al valore reale della vita. Il 6 settembre 2026 ha ricevuto il Premio Speciale Leone Lungo nell'ambito degli eventi collaterali della 83ª Mostra del Cinema di Venezia.","award":"Premio Speciale Leone Lungo — Venezia 83 (6 settembre 2026)","sameAs":"https://mariaantoninamacaluso.it/news/pochi-attimi-venezia-83"}],"actorIn":[{"@type":"TVSeries","name":"Creo Kitchens — Cucine Italiane","datePublished":"2021","image":"https://mariaantoninamacaluso.it/images/films/creo-kitchens.jpg","url":"https://mariaantoninamacaluso.it/altre-produzioni/creo-kitchens-cucine-italiane","director":{"@type":"Person","name":"Angelo Faraci"},"genre":"Cortometraggio — Pubblicità televisiva Sky","productionCompany":{"@type":"Organization","name":"Creo Kitchens — Cucine Italiane (Sky)"},"description":"Cortometraggio pubblicitario prodotto per Sky, girato nello showroom Creo di Viale del Fante, 61 ad Altomonte (Palermo). Maria Antonina Macaluso partecipa con ruolo di voce, accanto ad Angelo Faraci (attore protagonista)."},{"@type":"TVSeries","name":"Red Bull Minas Riders","datePublished":"2016","image":"https://mariaantoninamacaluso.it/images/films/red-bull-minas-riders.jpg","url":"https://mariaantoninamacaluso.it/altre-produzioni/red-bull-minas-riders","director":{"@type":"Person","name":"Ryan Meyers"},"genre":"Serie TV — Documentario sportivo","productionCompany":{"@type":"Organization","name":"Red Bull Media House"},"description":"Serie TV documentario-sportiva prodotta da Red Bull Media House dedicata alle competizioni di enduro estremo in Brasile. Maria Antonina Macaluso partecipa con ruolo di voce nell'episodio 'Bello Horizonte, 2017'.","sameAs":"https://www.imdb.com/title/tt10726880"},{"@type":"TVSeries","name":"Di Tutto un pò","datePublished":"2025","image":"https://mariaantoninamacaluso.it/images/films/di-tutto-un-po.jpg","url":"https://mariaantoninamacaluso.it/altre-produzioni/di-tutto-un-po","director":{"@type":"Person","name":"Sicilmedtv"},"genre":"Speciale TV — Talk show","productionCompany":{"@type":"Organization","name":"Sicilmedtv + Orawebtv"},"description":"Speciale TV trasmesso su Sicilmedtv e Orawebtv, formato talk show. Maria Antonina Macaluso ricopre il ruolo di Speaker, Angelo Faraci è Showman/Inviato. Scheda IMDb: tt39301887.","sameAs":"https://www.imdb.com/title/tt39301887"},{"@type":"TVSeries","name":"Eccellenza Siciliana","datePublished":"2025","image":"https://mariaantoninamacaluso.it/images/films/eccellenza-siciliana.jpg","url":"https://mariaantoninamacaluso.it/altre-produzioni/eccellenza-siciliana","director":{"@type":"Person","name":"Angelo Faraci"},"genre":"Film TV / Web — Documentario enogastronomico","productionCompany":{"@type":"Organization","name":"Angelo Faraci — Produzione indipendente"},"description":"Film TV e Web (2025) diretto da Angelo Faraci. Un viaggio attraverso la Sicilia alla scoperta dei prodotti di eccellenza. Maria Antonina Macaluso co-protagonista in viaggio con Angelo Faraci. IMDb: tt38949464.","sameAs":"https://www.imdb.com/title/tt38949464"}]}10:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$22"}}]
23:T4b5,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Chi è Maria Antonina Macaluso?","acceptedAnswer":{"@type":"Answer","text":"Maria Antonina Macaluso è un'attrice siciliana nata a Bologna il 9 novembre 2001 e cresciuta a Camporeale (Palermo). Ha debuttato nel 2019 con la fiction Sky 'Ciò che non ti ho detto' diretta da Angelo Faraci."}},{"@type":"Question","name":"Quali film ha interpretato Maria Antonina Macaluso?","acceptedAnswer":{"@type":"Answer","text":"Nove produzioni cinematografiche: Ciò che non ti ho detto (2019), Don't Be Silent (2020), Provvidenza (2022), Pietrazita (2023), Separati Mai (2023-2024), Vanina (2024), Il Mistero di Spartivento (2024-2025) e Pochi Attimi (2026)."}},{"@type":"Question","name":"Quando si sono fidanzati Maria Antonina Macaluso e Angelo Faraci?","acceptedAnswer":{"@type":"Answer","text":"Il 14 agosto 2019 a Palermo, l'indomani del compleanno di Angelo (nato il 13 agosto 1989)."}},{"@type":"Question","name":"Dove è nata Maria Antonina Macaluso?","acceptedAnswer":{"@type":"Answer","text":"Maria Antonina Macaluso è nata a Bologna il 9 novembre 2001 ed è cresciuta a Camporeale, in provincia di Palermo."}}]}11:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$23"}}]
