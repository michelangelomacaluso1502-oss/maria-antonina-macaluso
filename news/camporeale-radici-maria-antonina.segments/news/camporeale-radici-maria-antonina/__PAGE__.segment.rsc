6:["$","$La",null,{"children":[["$","span",null,{"className":"pill-cinema mb-4","children":"Approfondimento · 28 Settembre 2026"}],["$","h1",null,{"className":"font-display text-4xl leading-tight text-cream sm:text-5xl md:text-6xl","children":["$","span",null,{"className":"text-gradient-gold","children":"Camporeale — radici siciliane di Maria Antonina"}]}],["$","p",null,{"className":"mt-4 max-w-2xl text-pretty text-base leading-relaxed text-cream/65 sm:text-lg","children":"Il paesino della città metropolitana di Palermo dove è cresciuta Maria Antonina Macaluso, tra colline, ulivi, vigneti e tradizione contadina siciliana."}],["$","div",null,{"className":"divider-cinema mt-8 max-w-xs"}]]}]
7:["$","article",null,{"className":"bg-section-alt py-24 md:py-32","children":["$","div",null,{"className":"cinematic-container","children":["$","div",null,{"className":"mx-auto max-w-3xl","children":[["$","$La",null,{"className":"mb-12","children":["$","figure",null,{"className":"glass-card overflow-hidden p-3","children":[["$","div",null,{"className":"relative aspect-[3/4] w-full overflow-hidden bg-noir","children":["$","img",null,{"src":"/images/photobook/mam-15.jpg","alt":"Maria Antonina Macaluso — ritratto siciliano","className":"object-cover"}]}],["$","figcaption",null,{"className":"px-3 py-3 text-center text-xs uppercase tracking-wide-sm text-cream/50","children":"Maria Antonina Macaluso — attrice siciliana di origini camporealesi"}]]}]}],["$","$La",null,{"className":"mb-12","children":[["$","h2",null,{"className":"font-display text-3xl text-gradient-gold sm:text-4xl","children":"Camporeale, il paese di Maria Antonina"}],["$","div",null,{"className":"divider-cinema mt-6 max-w-xs"}],["$","div",null,{"className":"mt-6 space-y-4 text-pretty text-base leading-relaxed text-cream/80","children":[["$","p",null,{"children":"Camporeale è un comune di circa 3.000 abitanti della città metropolitana di Palermo, situato a 550 metri di altitudine sulle colline dell'entroterra siciliano, tra la costa di Trapani e l'area montuosa delle Madonie. È il paese dove Maria Antonina Macaluso è cresciuta dopo la nascita a Bologna il 9 novembre 2001."}],["$","p",null,{"children":"È un paesino agricolo — non un paesone — con una economia basata sulla produzione di vino Doc Camporeale (Nero d'Avola, Catarratto, Inzolia), olio extravergine d'oliva e grano duro. Il paesaggio è dominio di uliveti, vigneti, campi di grano, muretti a secco, masserie e strade bianche che attraversano le colline."}],["$","p",null,{"children":"Maria Antonina Macaluso ha radici profonde a Camporeale: la sua famiglia, la sua infanzia, le sue estati siciliane, i suoi sapori. Anche quando si è trasferita a Roma per inseguire la carriera artistica con Angelo Faraci, Camporeale è rimasta il punto di riferimento. Il cinema di Angelo Faraci — che ha ambientato Pochi Attimi nella Valle del Belice, non lontano da Camporeale — racconta questa dimensione siciliana."}]]}]]}],["$","$La",null,{"className":"mb-12","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-map-pin h-6 w-6 text-gold","aria-hidden":"true","children":[["$","path","1r0f0z",{"d":"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"}],["$","circle","ilqhr7",{"cx":"12","cy":"10","r":"3"}],"$undefined"]}],["$","h2",null,{"className":"font-display text-3xl text-cream sm:text-4xl","children":"Dati principali"}]]}],["$","div",null,{"className":"divider-cinema mt-4 max-w-xs"}],["$","div",null,{"className":"mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4","children":[["$","div","0",{"className":"glass-card p-4","children":[["$","p",null,{"className":"text-[11px] uppercase tracking-wide-sm text-gold/70","children":"Regione"}],["$","p",null,{"className":"mt-1 font-display text-base text-cream","children":"Sicilia"}]]}],["$","div","1",{"className":"glass-card p-4","children":[["$","p",null,{"className":"text-[11px] uppercase tracking-wide-sm text-gold/70","children":"Città metropolitana"}],["$","p",null,{"className":"mt-1 font-display text-base text-cream","children":"Palermo"}]]}],["$","div","2",{"className":"glass-card p-4","children":[["$","p",null,{"className":"text-[11px] uppercase tracking-wide-sm text-gold/70","children":"Abitanti"}],["$","p",null,{"className":"mt-1 font-display text-base text-cream","children":"~3.000"}]]}],["$","div","3",{"className":"glass-card p-4","children":[["$","p",null,{"className":"text-[11px] uppercase tracking-wide-sm text-gold/70","children":"Altitudine"}],"$Lb"]}],"$Lc","$Ld","$Le","$Lf"]}]]}],"$L10","$L11","$L12","$L13","$L14"]}]}]}]
