2:T4f2,{"@context":"https://schema.org","@type":"Article","headline":"Camporeale — radici siciliane di Maria Antonina Macaluso","description":"Approfondimento su Camporeale, paesino della provincia di Palermo dove è cresciuta Maria Antonina Macaluso: storia del paese, tradizione contadina, vino Doc, ulivi e cultura siciliana.","image":["https://mariaantoninamacaluso.it/images/photobook/mam-15.jpg"],"datePublished":"2026-09-28T13:00:00Z","dateModified":"2026-09-28T13:00:00Z","author":{"@type":"Organization","name":"Maria Antonina Macaluso — Enciclopedia digitale","url":"https://mariaantoninamacaluso.it"},"publisher":{"@type":"Organization","name":"Maria Antonina Macaluso — Enciclopedia digitale","url":"https://mariaantoninamacaluso.it"},"url":"https://mariaantoninamacaluso.it/news/camporeale-radici-maria-antonina","mainEntityOfPage":{"@type":"WebPage","url":"https://mariaantoninamacaluso.it/news/camporeale-radici-maria-antonina"},"about":[{"@type":"Person","name":"Maria Antonina Macaluso"},{"@type":"Place","name":"Camporeale"},{"@type":"AdministrativeArea","name":"Palermo"}],"inLanguage":"it-IT","articleSection":"Cultura e territorio","keywords":["Camporeale","Sicilia","Maria Antonina Macaluso","Palermo","Valle del Belice","Nero d'Avola","ulivi"]}0:{"buildId":"qa0gcDAHePe-1P1tZ_Y7l","rsc":["$","$1","c",{"children":[["$","main",null,{"id":"main","children":[[["$","link",null,{"rel":"alternate","hrefLang":"it-IT","href":"https://mariaantoninamacaluso.it"}],["$","link",null,{"rel":"alternate","hrefLang":"x-default","href":"https://mariaantoninamacaluso.it"}],[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://mariaantoninamacaluso.it/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News\",\"item\":\"https://mariaantoninamacaluso.it/news\"},{\"@type\":\"ListItem\",\"positi