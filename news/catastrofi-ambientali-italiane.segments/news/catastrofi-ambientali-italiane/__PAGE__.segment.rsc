12:["$","$Lb","3",{"children":["$","div",null,{"className":"glass-card p-5","children":[["$","div",null,{"className":"flex flex-wrap items-baseline gap-3","children":[["$","span",null,{"className":"font-display text-3xl text-gradient-gold","children":"2011"}],["$","span",null,{"className":"text-[11px] uppercase tracking-wide-sm text-gold/70","children":"Alluvione"}],["$","span",null,{"className":"text-base text-cream/70","children":["— ","Cinque Terre (Liguria)"]}]]}],["$","div",null,{"className":"mt-3 flex flex-wrap gap-4 text-xs text-cream/60","children":[false,["$","span",null,{"children":["Vittime: ",["$","strong",null,{"className":"text-cream","children":"~13"}]]}]]}],["$","p",null,{"className":"mt-3 text-sm leading-relaxed text-cream/80","children":"Alluvione delle Cinque Terre e della Versilia del 25 ottobre 2011, con piogge eccezionali che causarono esondazioni e frane."}]]}]}]
13:["$","$Lb","4",{"children":["$","div",null,{"className":"glass-card p-5","children":[["$","div",null,{"className":"flex flex-wrap items-baseline gap-3","children":[["$","span",null,{"className":"font-display text-3xl text-gradient-gold","children":"2013"}],["$","span",null,{"className":"text-[11px] uppercase tracking-wide-sm text-gold/70","children":"Alluvione"}],["$","span",null,{"className":"text-base text-cream/70","children":["— ","Sardegna"]}]]}],["$","div",null,{"className":"mt-3 flex flex-wrap gap-4 text-xs text-cream/60","children":[false,["$","span",null,{"children":["Vittime: ",["$","strong",null,{"className":"text-cream","children":"~16"}]]}]]}],["$","p",null,{"className":"mt-3 text-sm leading-relaxed text-cream/80","children":"Alluvione della Sardegna del novembre 2013, con il ciclone Cleopatra che colpì l'intera isola, causando esondazioni e morti."}]]}]}]
14:["$","$Lb","5",{"children":["$","div",null,{"className":"glass-card p-5","children":[["$","div",null,{"className":"flex flex-wrap items-baseline gap-3","children":[["$","span",null,{"className":"font-display text-3xl text-gradient-gold","children":"2017"}],["$","span",null,{"className":"text-[11px] uppercase tracking-wide-sm text-gold/70","children":"Frana"}],["$","span",null,{"className":"text-base text-cream/70","children":["— ","Ischia (Campania)"]}]]}],["$","div",null,{"className":"mt-3 flex flex-wrap gap-4 text-xs text-cream/60","children":[false,["$","span",null,{"children":["Vittime: ",["$","strong",null,{"className":"text-cream","children":"~1"}]]}]]}],["$","p",null,{"className":"mt-3 text-sm leading-relaxed text-cream/80","children":"Frana di Ischia del 26 novembre 2017, con una colata di fango che colpì Casamicciola Terme."}]]}]}]
15:["$","$Lb",null,{"className":"mb-12","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-history h-6 w-6 text-gold","aria-hidden":"true","children":[["$","path","1357e3",{"d":"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"}],["$","path","1xhq8a",{"d":"M3 3v5h5"}],["$","path","1fdv2h",{"d":"M12 7v5l4 2"}],"$undefined"]}],["$","h2",null,{"className":"font-display text-3xl text-cream sm:text-4xl","children":"Il terremoto del Belice del 1968"}]]}],["$","div",null,{"className":"divider-cinema mt-4 max-w-xs"}],["$","div",null,{"className":"mt-6 space-y-4 text-pretty text-base leading-relaxed text-cream/80","children":[["$","p",null,{"children":"Il terremoto della Valle del Belice del 14-15 gennaio 1968 è una delle catastrofi naturali più significative della storia siciliana recente. Con una magnitudo di 6.4, colpì una delle valli più povere della Sicilia occidentale, distruggendo i paesi di Gibellina, Poggioreale, Salaparuta, Montevago e Santa Margherita di Belice. Le vittime furono circa 370, con oltre 70.000 sfollati."}],["$","p",null,{"children":"La Valle del Belice divenne simbolo della ricostruzione fallita e della memoria del dolore. Gibellina vecchia fu abbandonata e ricostruita più a valle, mentre il Cretto di Burri — opera d'arte land art di Alberto Burri del 1984-1989 — ricopre le macerie del paese vecchio con enormi blocchi di cemento bianco, trasformando la ferita in opera d'arte."}],["$","p",null,{"children":"Maria Antonina Macaluso è cresciuta a Camporeale, paesino della provincia di Palermo a pochi chilometri dalla Valle del Belice. La sua partecipazione al film «Pochi Attimi» ha una dimensione biografica profonda: il racconto cinematografico delle catastrofi ambientali italiane è anche racconto delle radici di Maria Antonina, della sua infanzia in Sicilia, della memoria collettiva del terremoto del Belice."}]]}]]}]
16:["$","$Lb",null,{"className":"mb-12","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe h-6 w-6 text-gold","aria-hidden":"true","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","13o1zl",{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"}],["$","path","9i4pu4",{"d":"M2 12h20"}],"$undefined"]}],["$","h2",null,{"className":"font-display text-3xl text-cream sm:text-4xl","children":"La Valle del Belice e Camporeale"}]]}],["$","div",null,{"className":"divider-cinema mt-4 max-w-xs"}],["$","div",null,{"className":"mt-6 space-y-4 text-pretty text-base leading-relaxed text-cream/80","children":[["$","p",null,{"children":"La Valle del Belice è una zona geografica della Sicilia occidentale, in provincia di Trapani e Palermo, attraversata dal fiume Belice. È una delle aree più povere dell'isola, storicamente segnata dall'agricoltura contadina, dagli ulivi e dai vigneti che producono il famoso vino Nero d'Avola. I paesi della valle — Gibellina, Poggioreale, Salaparuta, Montevago, Santa Margherita di Belice, Contessa Entellina, Camporeale — sono comunità di poche migliaia di abitanti, custodi di una memoria storica e contadina profonda."}],["$","p",null,{"children":"Camporeale, il paese dove Maria Antonina Macaluso è cresciuta, è un comune di circa 3.000 abitanti in provincia di Palermo, situato sulle colline tra la costa e l'entroterra. Il paesaggio è dominato da uliveti, vigneti e campi di grano duro. Il vino è una delle risorse economiche principali del paese, con la denominazione Doc Camporeale."}],["$","p",null,{"children":"Il cinema di Angelo Faraci, scegliendo la Valle del Belice come ambientazione di Pochi Attimi, recupera una dimensione profonda del cinema siciliano: il racconto del territorio come luogo di memoria, di dolore e di rinascita. Una tradizione che parte da Pasquale Squitieri e Giuseppe Tornatore e arriva a Faraci, con Maria Antonina Macaluso come voce femminile di questa narrazione."}]]}]]}]
17:["$","$Lb",null,{"children":["$","div",null,{"className":"flex flex-wrap gap-4","children":[["$","$L3",null,{"href":"/film/pochi-attimi","className":"btn-cinema btn-cinema-solid","children":"Scheda film Pochi Attimi"}],["$","$L3",null,{"href":"/news/pochi-attimi-venezia-83","className":"btn-cinema","children":"Premio Leone Lungo"}],["$","$L3",null,{"href":"/news/cast-pochi-attimi","className":"btn-ghost-cinema","children":"Cast completo"}]]}]}]
