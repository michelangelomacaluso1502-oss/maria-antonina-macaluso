f:["$","p",null,{"className":"mt-3 text-sm leading-relaxed text-cream/80","children":"Terremoto che colpì la Valle del Belice in Sicilia, distruggendo i paesi di Gibellina, Poggioreale, Salaparuta, Montevago e Santa Margherita di Belice. Centro di rinascita culturale con il Cretto di Burri a Gibellina."}]
10:["$","$Lb","1",{"children":["$","div",null,{"className":"glass-card p-5","children":[["$","div",null,{"className":"flex flex-wrap items-baseline gap-3","children":[["$","span",null,{"className":"font-display text-3xl text-gradient-gold","children":"1980"}],["$","span",null,{"className":"text-[11px] uppercase tracking-wide-sm text-gold/70","children":"Terremoto"}],["$","span",null,{"className":"text-base text-cream/70","children":["— ","Irpinia (Campania)"]}]]}],["$","div",null,{"className":"mt-3 flex flex-wrap gap-4 text-xs text-cream/60","children":[["$","span",null,{"children":["Magnitudo: ",["$","strong",null,{"className":"text-cream","children":"6.9"}]]}],["$","span",null,{"children":["Vittime: ",["$","strong",null,{"className":"text-cream","children":"~2.914"}]]}]]}],["$","p",null,{"className":"mt-3 text-sm leading-relaxed text-cream/80","children":"Terremoto dell'Irpinia del 23 novembre 1980, colpì Campania, Basilicata e Puglia. Una delle più grandi catastrofi naturali italiane del Novecento."}]]}]}]
