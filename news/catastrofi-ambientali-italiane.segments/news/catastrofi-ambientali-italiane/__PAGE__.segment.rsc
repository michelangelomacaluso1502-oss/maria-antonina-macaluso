2:T52c,{"@context":"https://schema.org","@type":"Article","headline":"Catastrofi ambientali italiane — il film Pochi Attimi di Angelo Faraci","description":"Approfondimento delle catastrofi ambientali italiane raccontate nel film Pochi Attimi di Angelo Faraci: dal terremoto del Belice del 1968 alle alluvioni di Cinque Terre e Sardegna, fino al disastro di Sarno.","image":["https://mariaantoninamacaluso.it/images/venezia/venezia-05.jpg"],"datePublished":"2026-09-28T11:00:00Z","dateModified":"2026-09-28T11:00:00Z","author":{"@type":"Organization","name":"Maria Antonina Macaluso — Enciclopedia digitale","url":"https://mariaantoninamacaluso.it"},"publisher":{"@type":"Organization","name":"Maria Antonina Macaluso — Enciclopedia digitale","url":"https://mariaantoninamacaluso.it"},"url":"https://mariaantoninamacaluso.it/news/catastrofi-ambientali-italiane","mainEntityOfPage":{"@type":"WebPage","url":"https://mariaantoninamacaluso.it/news/catastrofi-ambientali-italiane"},"about":[{"@type":"Movie","name":"Pochi Attimi"},{"@type":"Person","name":"Angelo Faraci"},{"@type":"Person","name":"Maria Antonina Macaluso"}],"inLanguage":"it-IT","articleSection":"Cinema e storia","keywords":["Catastrofi ambientali italiane","terremoto Belice","alluvioni Italia","Pochi Attimi","Angelo Faraci","Valle del Belice","Camporeale"]}0:{"buildId":"l6YeBj2G9jTRu4DmmsMqA","rsc":["$","$1","c",{"children":[["$","main",null,{"id":"main","children":[[["$","link",null,{"rel":"alternate","hrefLang":"it-IT","href":"https://mariaantoninamacaluso.it"}],["$","link",null,{"rel":"alternate","hrefLang":"x-default","href":"https://mariaantoninamacaluso.it"}],[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://mariaantoninamacaluso.it/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News\",\"item\":\"https://mariaa