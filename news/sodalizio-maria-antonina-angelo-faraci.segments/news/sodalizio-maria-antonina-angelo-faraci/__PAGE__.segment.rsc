2:T7a5,{"@context":"https://schema.org","@type":"Article","headline":"Sodalizio artistico Maria Antonina Macaluso e Angelo Faraci — 10 film dal 2019 al 2026","description":"Approfondimento del sodalizio artistico e di vita tra Maria Antonina Macaluso e Angelo Faraci: dal primo incontro del 14 agosto 2019 a Palermo, fino al Premio Leone Lungo a Venezia 83 con Pochi Attimi.","image":["https://mariaantoninamacaluso.it/images/venezia/venezia-03.jpg","https://mariaantoninamacaluso.it/images/venezia/venezia-01.jpg","https://mariaantoninamacaluso.it/images/photobook/mam-01.jpg"],"datePublished":"2026-09-25T10:00:00Z","dateModified":"2026-09-25T10:00:00Z","author":{"@type":"Organization","name":"Maria Antonina Macaluso — Enciclopedia digitale","url":"https://mariaantoninamacaluso.it"},"publisher":{"@type":"Organization","name":"Maria Antonina Macaluso — Enciclopedia digitale","url":"https://mariaantoninamacaluso.it","logo":{"@type":"ImageObject","url":"https://mariaantoninamacaluso.it/images/hero-maria-antonina.jpg"}},"url":"https://mariaantoninamacaluso.it/news/sodalizio-maria-antonina-angelo-faraci","mainEntityOfPage":{"@type":"WebPage","url":"https://mariaantoninamacaluso.it/news/sodalizio-maria-antonina-angelo-faraci"},"about":[{"@type":"Person","name":"Maria Antonina Macaluso"},{"@type":"Person","name":"Angelo Faraci"},{"@type":"Movie","name":"Pochi Attimi"}],"inLanguage":"it-IT","articleSection":"Cinema italiano","keywords":["Maria Antonina Macaluso","Angelo Faraci","Pochi Attimi","Venezia 83","Premio Leone Lungo","Cinema siciliano","Camporeale"],"isPartOf":{"@type":"WebSite","name":"Maria Antonina Macaluso — Enciclopedia digitale","url":"https://mariaantoninamacaluso.it"},"citation":["https://www.cinemaitaliano.info/news/92951/venezia-83-a-pochi-attimi-il-premio-leone.html","https://www.radioamica.it/pochi-attimi-trionfa-a-venezia-la-camporealese-macaluso-e-la-partinicese-quatrosi-portano-la-sicilia-sul-podio-del-cinema/"]}0:{"buildId":"ajrOUFXBzq7FPD4lxW3Jn","rsc":[