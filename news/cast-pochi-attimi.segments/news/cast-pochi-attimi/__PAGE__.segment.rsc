8:["$","article",null,{"className":"bg-section-alt py-24 md:py-32","children":["$","div",null,{"className":"cinematic-container","children":["$","div",null,{"className":"mx-auto max-w-3xl","children":[["$","$Lb",null,{"className":"mb-12","children":["$","figure",null,{"className":"glass-card overflow-hidden p-3","children":[["$","div",null,{"className":"relative aspect-[3/4] w-full overflow-hidden bg-noir","children":["$","img",null,{"src":"/images/venezia/venezia-06.jpg","alt":"Cast di Pochi Attimi all'Hotel Excelsior Venezia 83","className":"object-cover"}]}],["$","figcaption",null,{"className":"px-3 py-3 text-center text-xs uppercase tracking-wide-sm text-cream/50","children":"Cast di Pochi Attimi — Hotel Excelsior, Lido di Venezia, 6 settembre 2026"}]]}]}],["$","$Lb",null,{"className":"mb-12","children":["$","div",null,{"className":"mt-6 space-y-4 text-pretty text-base leading-relaxed text-cream/80","children":[["$","p",null,{"children":"«Pochi Attimi» è il nuovo lungometraggio di Angelo Faraci, dedicato alle catastrofi ambientali italiane e al valore vero della vita. Il film ha ricevuto il Premio Speciale «Leone Lungo» alla 83ª Mostra del Cinema di Venezia il 6 settembre 2026. Il cast è composto da interpreti siciliani e attori di cinema, TV e teatro italiani."}],["$","p",null,{"children":"Maria Antonina Macaluso, attrice siciliana nata a Bologna il 9 novembre 2001 e cresciuta a Camporeale (Palermo), è la protagonista femminile del film. Angelo Faraci è regista, soggettista e attore protagonista nel ruolo di Salvatore. La sceneggiatura è di Rosaria Lo Porto, su soggetto di Angelo Faraci. Le musiche sono di Lorenzo Minardi. La produzione esecutiva è di Angelo Faraci e Angela Giardina. La direzione di produzione è affidata a Salvatore Alicata."}]]}]}],["$","$Lb",null,{"className":"mb-12","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24",