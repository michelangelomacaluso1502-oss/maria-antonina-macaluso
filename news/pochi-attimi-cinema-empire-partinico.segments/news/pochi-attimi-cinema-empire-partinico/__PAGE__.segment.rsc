7:["$","$L2",null,{"delay":120,"children":[["$","h2",null,{"className":"mt-12 mb-4 font-display text-3xl text-cream","children":"Il Cinema Empire di Partinico"}],["$","p",null,{"className":"text-pretty text-base leading-relaxed text-cream/75","children":"Il Cinema Empire è una delle realtà cinematografiche più importanti della provincia di Palermo. Situato nel cuore di Partinico, cittadina a pochi chilometri da Camporeale — il paese dove Maria Antonina Macaluso è cresciuta — il cinema rappresenta un punto di riferimento per la fruizione cinematografica nel territorio del Trapanese e della Sicilia occidentale."}]]}]
8:["$","$L2",null,{"delay":240,"children":[["$","h2",null,{"className":"mt-12 mb-4 font-display text-3xl text-cream","children":"Il film Pochi Attimi"}],["$","p",null,{"className":"text-pretty text-base leading-relaxed text-cream/75","children":[["$","em",null,{"children":"Pochi Attimi"}]," racconta la storia di una comunità felice che affronta la sfida più grande: comprendere che il valore VERO della vita sta nei pochi attimi che ci vengono concessi. Girato interamente in Sicilia tra i borghi dell'entroterra e le coste del Trapanese, il film segna il ritorno di Angelo Faraci dietro la macchina da presa dopo il successo del ciclo Separati Mai."]}]]}]
